# Next.js environment. `npx convex dev` writes the CONVEX_* lines into
# .env.local for you; add the Clerk keys from dashboard.clerk.com → API keys.

CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex-side variables are NOT read from this file. Set them on the
# deployment (`npm run setup:local` does it for local development):
#   CLERK_JWT_ISSUER_DOMAIN        e.g. https://your-app.clerk.accounts.dev
#   N8N_LOAN_EVENTS_WEBHOOK_URL    e.g. http://localhost:5678/webhook/lendloop/loan-events
#   LENDLOOP_SECRET_CONVEX_TO_N8N  same value as in n8n/.env
#   LENDLOOP_SECRET_N8N_TO_CONVEX  same value as in n8n/.env
