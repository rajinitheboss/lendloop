# n8n environment. Copy to n8n/.env (or run `npm run setup:local`).
# n8n/.env is git-ignored. Never commit real values.

# Encrypts credentials stored in n8n's database. Any long random string.
N8N_ENCRYPTION_KEY=

# Convex HTTP actions URL (NEXT_PUBLIC_CONVEX_SITE_URL in .env.local).
# Local Convex backend, seen from inside Docker:
LENDLOOP_API_URL=http://host.docker.internal:3211

# Used to build links in emails.
LENDLOOP_APP_URL=http://localhost:3000

# HMAC secrets. Must match the Convex env vars with the same names.
# One per direction, so a leaked secret only opens one direction.
LENDLOOP_SECRET_CONVEX_TO_N8N=
LENDLOOP_SECRET_N8N_TO_CONVEX=

LENDLOOP_MAIL_FROM="LendLoop <no-reply@lendloop.local>"
# Where the error workflow sends failure alerts.
LENDLOOP_OPS_EMAIL=ops@lendloop.local
